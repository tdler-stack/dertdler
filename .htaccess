# Steuerdatei fuer www.dertdler.de
# Gehoert in das Verzeichnis /www/dertdler.de/wordpress auf dem Webspace.

AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Alles auf https und www vereinheitlichen ---
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.dertdler.de%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.dertdler.de%{REQUEST_URI} [R=301,L]

# --- Alte WordPress-Adressen auf ihre neuen Entsprechungen ---
# Wer ein Lesezeichen oder einen Suchmaschinentreffer hat, landet richtig.
RewriteRule ^impressum/?$              /impressum.html    [R=301,L]
RewriteRule ^datenschutzerklaerung/?$  /datenschutz.html  [R=301,L]
RewriteRule ^datenschutz/?$            /datenschutz.html  [R=301,L]
RewriteRule ^agbs?/?$                  /                  [R=301,L]
RewriteRule ^elementor-[0-9]+/?$       /                  [R=301,L]

# --- Alles Uebrige auf die Startseite ---
# Greift nur, wenn weder Datei noch Verzeichnis existiert.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ / [R=302,L]
</IfModule>

# Falls mod_rewrite fehlt, wenigstens keine nackte Fehlerseite
ErrorDocument 404 /index.html

# --- Zwischenspeichern ---
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css   "access plus 7 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png  "access plus 30 days"
ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# --- Komprimierung ---
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
